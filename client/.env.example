# Copier ce fichier en .env (ignoré par Git) et adapter les valeurs.

# URL de base de l'API backend.
# En développement, Vite proxifie /api vers localhost:8080 (cf. vite.config.ts).
# En production, Nginx relaie /api vers le conteneur backend.
VITE_API_BASE_URL=/api/v1

# Active MSW (Mock Service Worker) pour travailler sans backend.
# true  -> aucun backend requis
# false -> appels réels vers localhost:8080
VITE_USE_MOCKS=true

# URL publique du site, utilisée pour les balises canonical / Open Graph.
VITE_SITE_URL=http://localhost:5173
